{% macro render_field(field, is_companion=False) %}
<div class="wbzp-intake-field">
    {% if field.type == 'boolean' %}
    <fieldset class="wbzp-intake-field-fieldset">
        <legend class="wbzp-intake-field-label">
            {{ field.label }}{% if field.required %}
            <span class="wbzp-intake-required-marker" aria-hidden="true">*</span>
            {% endif %}
        </legend>
        <div class="wbzp-intake-radio-group">
            <label
                ><input
                    type="radio"
                    name="{{ field.name }}"
                    value="true"
                    {% if is_companion %}data-wbzp-intake-required="{% if field.required %}true{% else %}false{% endif %}"{% endif %}
                    {% if field.required %}required{% endif %}
                />
                Yes</label
            >
            <label
                ><input
                    type="radio"
                    name="{{ field.name }}"
                    value="false"
                    {% if is_companion %}data-wbzp-intake-required="{% if field.required %}true{% else %}false{% endif %}"{% endif %}
                    {% if field.required %}required{% endif %}
                />
                No</label
            >
        </div>
    </fieldset>
    {% elif field.type == 'select' %}
    <label for="wbzp-intake-field-{{ field.name }}"
        >{{ field.label }}{% if field.required %}
        <span class="wbzp-intake-required-marker" aria-hidden="true">*</span>
        {% endif %}</label
    >
    <select
        id="wbzp-intake-field-{{ field.name }}"
        name="{{ field.name }}"
        {% if is_companion %}data-wbzp-intake-required="{% if field.required %}true{% else %}false{% endif %}"{% endif %}
        {% if field.required %}required{% endif %}
    >
        <option value="" disabled selected>Choose one</option>
        {% for option in field.options.keys() %}
        <option value="{{ option }}">{{ option }}</option>
        {% endfor %}
    </select>
    {% elif field.type == 'multiselect' %}
    <fieldset class="wbzp-intake-field-fieldset">
        <legend class="wbzp-intake-field-label">
            {{ field.label }}{% if field.required %}
            <span class="wbzp-intake-required-marker" aria-hidden="true">*</span>
            {% endif %}
        </legend>
        <div
            class="wbzp-intake-checkbox-group"
            data-wbzp-intake-multiselect="{{ field.name }}"
            {% if field.required %}data-wbzp-intake-multiselect-required="true"{% endif %}
        >
            {% for option in field.options.keys() %}
            <label
                ><input
                    type="checkbox"
                    name="{{ field.name }}"
                    value="{{ option }}"
                />
                {{ option }}</label
            >
            {% endfor %}
        </div>
    </fieldset>
    {% elif field.type == 'textarea' %}
    <label for="wbzp-intake-field-{{ field.name }}"
        >{{ field.label }}{% if field.required %}
        <span class="wbzp-intake-required-marker" aria-hidden="true">*</span>
        {% endif %}</label
    >
    <textarea
        id="wbzp-intake-field-{{ field.name }}"
        name="{{ field.name }}"
        maxlength="{{ field.get('length', {}).get('max', max_textarea_length) }}"
        {% if field.length and field.length.min is defined %}minlength="{{ field.length.min }}"{% endif %}
        placeholder="Type your answer here"
        {% if is_companion %}data-wbzp-intake-required="{% if field.required %}true{% else %}false{% endif %}"{% endif %}
        {% if field.required %}required{% endif %}
    ></textarea>
    {% elif field.type == 'number' %}
    <label for="wbzp-intake-field-{{ field.name }}"
        >{{ field.label }}{% if field.required %}
        <span class="wbzp-intake-required-marker" aria-hidden="true">*</span>
        {% endif %}</label
    >
    <input
        id="wbzp-intake-field-{{ field.name }}"
        type="number"
        name="{{ field.name }}"
        placeholder="00"
        {% if field.range and field.range.min is defined %}min="{{ field.range.min }}"{% endif %}
        {% if field.range and field.range.max is defined %}max="{{ field.range.max }}"{% endif %}
        {% if is_companion %}data-wbzp-intake-required="{% if field.required %}true{% else %}false{% endif %}"{% endif %}
        {% if field.required %}required{% endif %}
    />
    {% else %}
    <label for="wbzp-intake-field-{{ field.name }}"
        >{{ field.label }}{% if field.required %}
        <span class="wbzp-intake-required-marker" aria-hidden="true">*</span>
        {% endif %}</label
    >
    <input
        id="wbzp-intake-field-{{ field.name }}"
        type="{{ field.type }}"
        name="{{ field.name }}"
        maxlength="{{ field.get('length', {}).get('max', max_text_length) }}"
        {% if field.length and field.length.min is defined %}minlength="{{ field.length.min }}"{% endif %}
        placeholder="Type your answer here"
        {% if is_companion %}data-wbzp-intake-required="{% if field.required %}true{% else %}false{% endif %}"{% endif %}
        {% if field.required %}required{% endif %}
    />
    {% endif %}
    {% if field.note %} {% set note_type = field.note.type | default('info') %}
    <details class="wbzp-intake-field-note wbzp-intake-field-note--{{ note_type }}">
        <summary>
            <span class="wbzp-intake-field-note-title">
                {% if note_type == 'caution' %}
                <svg class="wbzp-intake-field-note-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3.5 L21.5 20 H2.5 Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                    <rect x="11" y="9" width="2" height="6" rx="1" fill="currentColor" />
                    <circle cx="12" cy="17.5" r="1.2" fill="currentColor" />
                </svg>
                {% elif note_type == 'warning' %}
                <svg class="wbzp-intake-field-note-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 3 H16 L21 8 V16 L16 21 H8 L3 16 V8 Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                    <rect x="11" y="7" width="2" height="7" rx="1" fill="currentColor" />
                    <circle cx="12" cy="17" r="1.2" fill="currentColor" />
                </svg>
                {% else %}
                <svg class="wbzp-intake-field-note-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
                    <circle cx="12" cy="8" r="1.2" fill="currentColor" />
                    <rect x="11" y="11" width="2" height="6" rx="1" fill="currentColor" />
                </svg>
                {% endif %}
                <span class="sr-only"
                    >{% if note_type == 'caution' %}Caution: {% elif note_type == 'warning' %}Warning: {% else %}Info: {% endif %}</span
                >{{ field.note.title }}
            </span>
        </summary>
        {{ field.note.text | markdown }}
    </details>
    {% endif %}
    {% if field.type in ('text', 'email', 'textarea') %}
    <p class="wbzp-intake-char-counter" aria-hidden="true"></p>
    {% endif %}
    {% if field.options and field.type in ('boolean', 'select', 'multiselect') %}
        {% for option, companion in field.options.items() %}
            {% if companion %}
    <div class="wbzp-intake-field-companion" data-wbzp-intake-companion-of="{{ field.name }}" data-wbzp-intake-companion-when="{{ option }}" hidden>
        {{ render_field(companion, is_companion=True) }}
    </div>
            {% endif %}
        {% endfor %}
    {% endif %}
</div>
{% endmacro %}
{% if turnstile_site_key %}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{% endif %}
<link rel="stylesheet" href="{{ css_url }}" />
<form class="wbzp-intake-form" method="post" action="{{ action }}" novalidate>
    {% for field in application_fields %}{{ render_field(field) }}{% endfor %}
    {% if turnstile_site_key %}
    <div class="cf-turnstile" data-sitekey="{{ turnstile_site_key }}" data-size="flexible"></div>
    {% endif %}
    <div class="wbzp-intake-message" role="status" hidden></div>
    <button type="submit" class="wbzp-intake-btn">Submit</button>
</form>
<script src="{{ js_url }}"></script>
