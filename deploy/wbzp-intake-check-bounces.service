[Unit]
Description=Check the wbzp-intake bounce mailbox
After=network.target

[Service]
Type=oneshot
TimeoutStartSec=0
User=__RUN_AS_USER__
Group=__RUN_AS_USER__
WorkingDirectory=__APP_ROOT__
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__APP_ROOT__/instance
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=__APP_ROOT__/.venv/bin/flask --app app bounce-check
